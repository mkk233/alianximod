    {
      "row": 8,
      "id": "sword_array",
      "name": "列剑",
      "cells": {
        "A": {
          "type": "inlineStr",
          "value": "列剑",
          "style": "1",
          "xml": "<c r=\"A8\" s=\"1\" t=\"inlineStr\"><is><t>&#21015;&#21073;</t></is></c>"
        },
        "B": {
          "type": "inlineStr",
          "value": "sword_array",
          "style": "1",
          "xml": "<c r=\"B8\" s=\"1\" t=\"inlineStr\"><is><t>sword_array</t></is></c>"
